    {
      "id": "xzMBzuc9iPEaXXv9GRsbu",
      "type": "text",
      "x": 1105.8427623843152,
      "y": 813.5085881522134,
      "width": 598.3994750976562,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aM",
      "roundness": null,
      "seed": 1713425786,
      "version": 109,
      "versionNonce": 1658099706,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785274047604,
      "link": null,
      "locked": false,
      "text": "On them, it's true that alpha == 0 || beta == 0 || gamma == 0",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "On them, it's true that alpha == 0 || beta == 0 || gamma == 0",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "_XUMG97aSRZO_ZYMBEvZs",
      "type": "text",
      "x": 1194.6303124552117,
      "y": 862.1654739626579,
      "width": 544.1795654296875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aN",
      "roundness": null,
      "seed": 1408655738,
      "version": 199,
      "versionNonce": 446917434,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785274130772,
      "link": null,
      "locked": false,
      "text": "But this is not a \"Do I paint or not paint?\" question.\nWe have to use the values of alpha, beta and gamma to\ngive the triangle stronger or weaker colours",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "But this is not a \"Do I paint or not paint?\" question.\nWe have to use the values of alpha, beta and gamma to\ngive the triangle stronger or weaker colours",
      "autoResize": true,
      "lineHeight": 1.25
    },
