      "type": "text",
      "x": 3255.9889735932984,
      "y": 2140.4357449016793,
      "width": 7367.722220921932,
      "height": 226.52091658723606,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
