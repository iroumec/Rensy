      "roundness": null,
      "seed": 1146105589,
      "version": 132,
      "versionNonce": 743817749,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785001193476,
      "link": null,
      "locked": false,
      "text": "If I look from the origin A, is vector AC to the left or to the right of vector AB?",
      "fontSize": 181.21673326978905,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If I look from the origin A, is vector AC to the left or to the right of vector AB?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "lwC7V9TFl3AAdFdS2UQvE",
      "type": "text",
      "x": 7686.571511716675,
      "y": 1745.3616932777277,
      "width": 1065.6591796875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b38",
      "roundness": null,
      "seed": 923062261,
      "version": 115,
      "versionNonce": 1333116277,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785001648158,
      "link": null,
      "locked": false,
      "text": "AC is to the left of AB from A perspective, so the area is positive USING THE CONVENTION MENTIONED.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AC is to the left of AB from A perspective, so the area is positive USING THE CONVENTION MENTIONED.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "etl2sl-GVggqKNkZkrD-T",
      "type": "text",
      "x": 7808.268364957277,
      "y": 1824.8163775313035,
      "width": 733.939208984375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b39",
      "roundness": null,
      "seed": 136097013,
      "version": 135,
      "versionNonce": 1602789045,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785001310764,
      "link": null,
      "locked": false,
      "text": "It doesn't matter if it's the shortest way or no. Rotation doesn't matter.\nIt's just a pedagogic point of view.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It doesn't matter if it's the shortest way or no. Rotation doesn't matter.\nIt's just a pedagogic point of view.",
      "autoResize": true,
      "lineHeight": 1.25
    },
