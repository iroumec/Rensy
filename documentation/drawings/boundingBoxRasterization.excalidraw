      "isDeleted": false,
      "boundElements": null,
      "updated": 1785000854014,
      "link": null,
      "locked": false,
      "text": "There are always three points: A, B and C\n\nBy convention, the sign of the area depends on wether I have to do\na counter-clockwise rotation (positive) or a clockwise rotation (negative) to go from\nAB to AC",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "There are always three points: A, B and C\n\nBy convention, the sign of the area depends on wether I have to do\na counter-clockwise rotation (positive) or a clockwise rotation (negative) to go from\nAB to AC",
      "autoResize": true,
      "lineHeight": 1.25
