      "link": null,
      "locked": false,
      "text": "The GPU receives the data saved in the vertices buffers.\n- Position.\n- Normal.\n- Colour.\n- Texture Coordinates (UV).\n- Tangents.\n- Any other attribute defined by the user.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
