      "isDeleted": false,
      "boundElements": null,
      "updated": 1785592819656,
      "link": null,
      "locked": false,
      "text": "The final colour is stored in memory.\n\nWhen the pipeline finishes, the framebuffer contains the\ncomplete image.\n\nThe monitor shows this content.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The final colour is stored in memory.\n\nWhen the pipeline finishes, the framebuffer contains the\ncomplete image.\n\nThe monitor shows this content.",
      "autoResize": true,
      "lineHeight": 1.25
    },
