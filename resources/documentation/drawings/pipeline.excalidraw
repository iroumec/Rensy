      "isDeleted": false,
      "boundElements": null,
      "updated": 1785592711947,
      "link": null,
      "locked": false,
      "text": "It uses an aditional buffer for deciding where to draw.\n\nIt's useful for:\n- Mirrors.\n- Portals.\n- Masks.\n- Contours.\n- Special effects.\n\nIT DOESN'T MODIFY THE COLOUR.\n\nIt just allows or denies the drawing.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It uses an aditional buffer for deciding where to draw.\n\nIt's useful for:\n- Mirrors.\n- Portals.\n- Masks.\n- Contours.\n- Special effects.\n\nIT DOESN'T MODIFY THE COLOUR.\n\nIt just allows or denies the drawing.",
      "autoResize": true,
      "lineHeight": 1.25
    },
