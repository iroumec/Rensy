      "version": 42,
      "versionNonce": 1083675315,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785592559958,
      "link": null,
      "locked": false,
      "text": "Its output usually is a colour.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Its output usually is a colour.",
