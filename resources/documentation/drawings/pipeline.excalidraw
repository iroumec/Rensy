      "locked": false,
      "text": "It's job is deciding the final colour.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It's job is deciding the final colour.",
