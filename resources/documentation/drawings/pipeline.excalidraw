      "isDeleted": false,
      "boundElements": null,
      "updated": 1785592529211,
      "link": null,
      "locked": false,
      "text": "It can:\n- Read textures.\n- Calculate ilumination.\n- Apply shading.\n- Calculate highlights.\n- Use normals.\n- Make fog effects.\n- Discard fragments.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It can:\n- Read textures.\n- Calculate ilumination.\n- Apply shading.\n- Calculate highlights.\n- Use normals.\n- Make fog effects.\n- Discard fragments.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Ch83BKxIRHXwkq6NhJra7",
      "type": "text",
      "x": 415.468435348663,
      "y": 3344.779904782381,
      "width": 292.8197326660156,
      "height": 25,
      "angle": 0,
