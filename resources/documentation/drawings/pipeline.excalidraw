      "isDeleted": false,
      "boundElements": null,
      "updated": 1785592250698,
      "link": null,
      "locked": false,
      "text": "Now the GPU wonders: what pixels each primitive covers?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Now the GPU wonders: what pixels each primitive covers?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Dxnz-9uUn55Bh2NyTMqKe",
      "type": "text",
      "x": 427.75,
      "y": 2494.6171875,
      "width": 617.4794311523438,
