      "roundness": null,
      "seed": 1202419635,
      "version": 150,
      "versionNonce": 559511827,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785592408003,
      "link": null,
      "locked": false,
      "text": "It does the same with UV, normals, positions and any attribute sent by the vertex shader.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It does the same with UV, normals, positions and any attribute sent by the vertex shader.",
