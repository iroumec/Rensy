      "updated": 1785592601406,
      "link": null,
      "locked": false,
      "text": "Sometimes, two triangles produce fragments for a same pixel.\n\nWhich one should be observed?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sometimes, two triangles produce fragments for a same pixel.\n\nWhich one should be observed?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XpBe3awG0dvZGCSb1RzMf",
      "type": "text",
      "x": 416.48290319009897,
      "y": 3595.598763267244,
      "width": 262.7197265625,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
