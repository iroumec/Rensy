      "isDeleted": false,
      "boundElements": null,
      "updated": 1785592164066,
      "link": null,
      "locked": false,
      "text": "For example:\n\n  - (-1, -1) -> (0, 0)\n  - (1, 1) -> (1920, 1080)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For example:\n\n  - (-1, -1) -> (0, 0)\n  - (1, 1) -> (1920, 1080)",
