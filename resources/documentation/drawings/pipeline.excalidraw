      "isDeleted": false,
      "boundElements": null,
      "updated": 1785592623424,
      "link": null,
      "locked": false,
      "text": "More distant -> Discarded.\n\nNearer -> Drawed.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "More distant -> Discarded.\n\nNearer -> Drawed.",
