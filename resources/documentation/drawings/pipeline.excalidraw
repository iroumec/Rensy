      "isDeleted": false,
      "boundElements": null,
      "updated": 1785593222606,
      "link": null,
      "locked": false,
      "text": "Here also is the input of indices.\n\nVertex Buffer (VBO): containes the attributes of the vertices (position, normal, UV...).\nIndex Buffer (EBO/IBO): contains the indices that indicate what vertices form each primitive.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Here also is the input of indices.\n\nVertex Buffer (VBO): containes the attributes of the vertices (position, normal, UV...).\nIndex Buffer (EBO/IBO): contains the indices that indicate what vertices form each primitive.",
      "autoResize": true,
      "lineHeight": 1.25
    }
