    {
      "id": "4rflEjzbCGIyNnJGE8xKn",
      "type": "text",
      "x": 2566.1678725107604,
      "y": 1985.950654411349,
      "width": 1000.3990478515625,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ac",
      "roundness": null,
      "seed": 1923217363,
      "version": 155,
      "versionNonce": 681555581,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785875433104,
      "link": null,
      "locked": false,
      "text": "The process for face normal is quite similar but, instead of a line per vertex, we calculate the average\nof the vertices and that's P.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The process for face normal is quite similar but, instead of a line per vertex, we calculate the average\nof the vertices and that's P.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "alRzwf56CM5Sv04AuQ00z",
      "type": "text",
      "x": -541.6198485601499,
      "y": 1376.2378117770586,
      "width": 941.9591064453125,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ad",
      "roundness": null,
      "seed": 776348435,
      "version": 476,
      "versionNonce": 69927933,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785875650302,
      "link": null,
      "locked": false,
      "text": "It's important to note that all this process is done in the geometry shader, which must be done\nbefore culling, clipping, rasterization and so on. It's done after primtive assembly.\n\nThe reason behind this is that a geometry shader can:\n- Delete a primitive.\n- Modify a primitive.\n- Generate more primitives.7\n\nSometimes, an early culling is applied before the geometry shader, but that's not the standard.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It's important to note that all this process is done in the geometry shader, which must be done\nbefore culling, clipping, rasterization and so on. It's done after primtive assembly.\n\nThe reason behind this is that a geometry shader can:\n- Delete a primitive.\n- Modify a primitive.\n- Generate more primitives.7\n\nSometimes, an early culling is applied before the geometry shader, but that's not the standard.",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
