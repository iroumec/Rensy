    {
      "id": "voj4etZnvvWthxN895vkq",
      "type": "text",
      "x": 2044.322830420992,
      "y": 1436.0758805260614,
      "width": 1039.63916015625,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aX",
      "roundness": null,
      "seed": 572686429,
      "version": 263,
      "versionNonce": 483980125,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785871714112,
      "link": null,
      "locked": false,
      "text": "The colour of P' (the copy of P we save in the Line so we can assign it its properties)\nwill be locked, as well as Q's colour. This is intended so the line will always be drawn using the same colour.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The colour of P' (the copy of P we save in the Line so we can assign it its properties)\nwill be locked, as well as Q's colour. This is intended so the line will always be drawn using the same colour.",
      "autoResize": true,
      "lineHeight": 1.25
    },
