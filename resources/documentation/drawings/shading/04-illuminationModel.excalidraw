    {
      "id": "3Rz7pC2M0H8uerVN96qPc",
      "type": "text",
      "x": 335.90661621280003,
      "y": 1827.6009717186357,
      "width": 854.8591918945312,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aL",
      "roundness": null,
      "seed": 947298848,
      "version": 18,
      "versionNonce": 804962218,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786030474914,
      "link": null,
      "locked": false,
      "text": "Flat, Gouraud, and Phong are three strategies for determining when to evaluate\nlighting. The fragment shader is simply the place where the final color of a fragment\nis produced.\n\nReal-world renderers allow for the simulation of each of these lighting models by having\nthe user program separate shaders, rather than by creating classes. However, for the\npurpose of the renderer, we must create classes that pass through various stages and\nperform tasks at the appropriate stages.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Flat, Gouraud, and Phong are three strategies for determining when to evaluate\nlighting. The fragment shader is simply the place where the final color of a fragment\nis produced.\n\nReal-world renderers allow for the simulation of each of these lighting models by having\nthe user program separate shaders, rather than by creating classes. However, for the\npurpose of the renderer, we must create classes that pass through various stages and\nperform tasks at the appropriate stages.",
      "autoResize": true,
      "lineHeight": 1.25
    },
