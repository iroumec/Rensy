    {
      "id": "SYooRrPhSzvQoA0dSNbrZ",
      "type": "text",
      "x": 898.3459342452666,
      "y": 2229.6969191504513,
      "width": 752.25927734375,
      "height": 250,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aN",
      "roundness": null,
      "seed": 1798702634,
      "version": 203,
      "versionNonce": 65358250,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786030573212,
      "link": null,
      "locked": false,
      "text": "For that purpose, I plan to replace the current (at the date of writing this)\nshading factory/instance for just a lighting model like the following one:\n\nclass LightingModel\n{\npublic:\n    virtual void processVertex(VertexOut&) {}\n    virtual void processPrimitive(Primitive&) {}\n    virtual void processFragment(Fragment&) {}\n};",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For that purpose, I plan to replace the current (at the date of writing this)\nshading factory/instance for just a lighting model like the following one:\n\nclass LightingModel\n{\npublic:\n    virtual void processVertex(VertexOut&) {}\n    virtual void processPrimitive(Primitive&) {}\n    virtual void processFragment(Fragment&) {}\n};",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "j0H_4M-0vE5Tfwgd8KM22",
      "type": "text",
      "x": 898.7764598912488,
      "y": 2527.338133714962,
      "width": 769.3993530273438,
      "height": 25,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aO",
      "roundness": null,
      "seed": 1466591018,
      "version": 92,
      "versionNonce": 360345718,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786030642666,
      "link": null,
      "locked": false,
      "text": "Each shading or lighting model will implement the things that it needs. That is:",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each shading or lighting model will implement the things that it needs. That is:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "quBQ6_FL6DiMs9s7Fa7fH",
      "type": "text",
      "x": 1072.2379334427667,
      "y": 2582.805308932873,
      "width": 626.9991455078125,
      "height": 400,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aP",
      "roundness": null,
      "seed": 312822518,
      "version": 37,
      "versionNonce": 860650794,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786030654193,
      "link": null,
      "locked": false,
      "text": "class FlatLighting : public LightingModel\n{\n    void processPrimitive(Primitive& primitive) override;\n};\n\n\nclass GouraudLighting : public LightingModel\n{\n    void processVertex(VertexOut& vertex) override;\n};\n\n\nclass PhongLighting : public LightingModel\n{\n    void processFragment(Fragment& fragment) override;\n};",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class FlatLighting : public LightingModel\n{\n    void processPrimitive(Primitive& primitive) override;\n};\n\n\nclass GouraudLighting : public LightingModel\n{\n    void processVertex(VertexOut& vertex) override;\n};\n\n\nclass PhongLighting : public LightingModel\n{\n    void processFragment(Fragment& fragment) override;\n};",
      "autoResize": true,
      "lineHeight": 1.25
