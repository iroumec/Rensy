    {
      "id": "h-fTWlsBNUiiNIkHavA4N",
      "type": "text",
      "x": 206.13117303487138,
      "y": 1084.1536052072727,
      "width": 543.6395263671875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#f08c00",
