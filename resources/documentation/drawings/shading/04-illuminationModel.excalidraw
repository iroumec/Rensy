      "isDeleted": false,
      "boundElements": [],
      "updated": 1785961477027,
      "link": null,
      "locked": false,
      "text": "out float intensity;\n\nvoid main()\n{\n    intensity = dot(vertexNormal, lightDirection);\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "out float intensity;\n\nvoid main()\n{\n    intensity = dot(vertexNormal, lightDirection);\n}",
