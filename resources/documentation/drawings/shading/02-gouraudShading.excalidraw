    {
      "id": "LXdqzhoMwl1UK5Q6byzLc",
      "type": "text",
      "x": 2071.4272669084876,
      "y": 1785.6956961551414,
      "width": 278.29974365234375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ad",
      "roundness": null,
      "seed": 67638856,
      "version": 32,
      "versionNonce": 1809996088,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785692492933,
      "link": null,
      "locked": false,
      "text": "The result looks quite good.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The result looks quite good.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "winQsbg_emyOW-K2rNzQa",
      "type": "text",
      "x": 2140.486737831711,
      "y": 1892.4733350617669,
      "width": 374.4596252441406,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ae",
      "roundness": null,
      "seed": 963986488,
      "version": 245,
      "versionNonce": 414166840,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785692668713,
      "link": null,
      "locked": false,
      "text": "However, this algorithm is not perfect:\n\nAdvantages:\n- Computationally cheap.\n- Surfaces seem smooth.\n\nDisadvantages:\n- The specular lights might dissapear.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "However, this algorithm is not perfect:\n\nAdvantages:\n- Computationally cheap.\n- Surfaces seem smooth.\n\nDisadvantages:\n- The specular lights might dissapear.",
      "autoResize": true,
      "lineHeight": 1.25
    },
