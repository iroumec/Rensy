      "isDeleted": false,
      "boundElements": [],
      "updated": 1785524843785,
      "link": null,
      "locked": false,
      "text": "Now we have to calculate the diffuse and specular lights.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Now we have to calculate the diffuse and specular lights.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "dF1ov4bPEXCVhVKG81d9D",
      "type": "text",
      "x": 379.5228136178847,
      "y": 1260.5624194563143,
      "width": 920.3192138671875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
