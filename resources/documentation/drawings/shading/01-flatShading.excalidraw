      "isDeleted": false,
      "boundElements": [],
      "updated": 1785529082213,
      "link": null,
      "locked": false,
      "text": "For both variants defined before, we must calculate the angle between the vector and the indirect light.\n\nWell, in reality, the angle is not of interest: we just need a value which tells us how strong in the lighti n that point.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For both variants defined before, we must calculate the angle between the vector and the indirect light.\n\nWell, in reality, the angle is not of interest: we just need a value which tells us how strong in the lighti n that point.",
      "autoResize": true,
      "lineHeight": 1.25
    },
