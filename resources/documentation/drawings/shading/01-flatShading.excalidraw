      "seed": 1436710559,
      "version": 38,
      "versionNonce": 618635313,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785524496808,
      "link": null,
      "locked": false,
      "text": "For example, we can use a dark gray:",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For example, we can use a dark gray:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "LPjfZzlgq2JQJ3vRxQ6Di",
      "type": "text",
      "x": 353.08161118892747,
      "y": 918.6930313992148,
      "width": 1262.098876953125,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a6",
      "roundness": null,
      "seed": 1772619761,
      "version": 534,
      "versionNonce": 193768977,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785524714477,
      "link": null,
      "locked": false,
      "text": "After this, we must definy the position of the light point. From this point, the resulting face in each face of the model will\nbe calculated.\n\n(This is just defining a vector with the light position. For example, (2, 2, 4)).\n\nNow, this light point is in world coordinates or in camera coordinates? It could be in either of them. However, the coordinates we\nchoose must go under the required transformations seen.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "After this, we must definy the position of the light point. From this point, the resulting face in each face of the model will\nbe calculated.\n\n(This is just defining a vector with the light position. For example, (2, 2, 4)).\n\nNow, this light point is in world coordinates or in camera coordinates? It could be in either of them. However, the coordinates we\nchoose must go under the required transformations seen.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "BG9UM1DbLVIC1zGXJ5r3a",
      "type": "text",
      "x": 430.18802208224037,
      "y": 1168.8976575691688,
      "width": 558.95947265625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
