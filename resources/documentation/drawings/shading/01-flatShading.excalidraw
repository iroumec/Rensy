    {
      "id": "IBxnr5VCRIhkT-IMvE_SA",
      "type": "text",
      "x": 580.6972588315812,
      "y": 665.1316442088462,
      "width": 356.1796875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a5",
