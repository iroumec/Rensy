    {
      "id": "YqBYbXZSpUj9P11fVfhW7",
      "type": "text",
      "x": 811.7082058346065,
      "y": 1840.4173707664754,
      "width": 530.9194946289062,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
