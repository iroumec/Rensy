      "isDeleted": false,
      "boundElements": null,
      "updated": 1785697408273,
      "link": null,
      "locked": false,
      "text": "Advantages:\n\n- Correct specular highlights.\n- Better visual quality.\n- Smoother surfaces.\n\nDisadvantages:\n\n- Performance. The lighting is calculated per fragment.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Advantages:\n\n- Correct specular highlights.\n- Better visual quality.\n- Smoother surfaces.\n\nDisadvantages:\n\n- Performance. The lighting is calculated per fragment.",
      "autoResize": true,
      "lineHeight": 1.25
    },
