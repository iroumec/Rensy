    {
      "id": "mtpQZ_aG1l7ml8psUjXFo",
      "type": "text",
      "x": 861.203125,
      "y": 579.9375,
      "width": 540.0196533203125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aF",
      "roundness": null,
      "seed": 87162440,
      "version": 94,
      "versionNonce": 189570872,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785695111365,
      "link": null,
      "locked": false,
      "text": "The normal of F will be calculated\nas alpha * normalA + beta * normalB + gamma * normalC",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The normal of F will be calculated\nas alpha * normalA + beta * normalB + gamma * normalC",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "gr953Ms-I9LZCxK0J-Vf8",
      "type": "text",
      "x": 392.828125,
      "y": 868.09375,
      "width": 456.11956787109375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aG",
      "roundness": null,
      "seed": 1352179272,
      "version": 61,
      "versionNonce": 86622792,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785695134998,
      "link": null,
      "locked": false,
      "text": "The illumination occurs in the fragment shader.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The illumination occurs in the fragment shader.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "YT9SHq1rgdifcPcKXQaoQ",
      "type": "text",
      "x": 350.03125,
      "y": 970.328125,
      "width": 1350.138916015625,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aH",
      "roundness": null,
      "seed": 709087304,
      "version": 209,
      "versionNonce": 379160632,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785695189668,
      "link": null,
      "locked": false,
      "text": "Of course, there are multiple ways of calculating the normal of vertex. We can use the adjacent faces (like we did in the gouraud shading)\nor we can use the normals that can be obtained from the .obj file.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Of course, there are multiple ways of calculating the normal of vertex. We can use the adjacent faces (like we did in the gouraud shading)\nor we can use the normals that can be obtained from the .obj file.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qaKjg_M6e1KKH-S0s7NKG",
      "type": "text",
      "x": 459.4030667626856,
      "y": 1091.1079051201211,
      "width": 849.7591552734375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aI",
      "roundness": null,
      "seed": 1045240904,
      "version": 173,
      "versionNonce": 85038392,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785695533322,
      "link": null,
      "locked": false,
      "text": "This is approach is less computationally efficient, due to the light intensity calculation\nmust be done per fragment. However, it achieves a more realistic result.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This is approach is less computationally efficient, due to the light intensity calculation\nmust be done per fragment. However, it achieves a more realistic result.",
