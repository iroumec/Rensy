    {
      "id": "1A5zvqhZ1wB8SNXUWS22h",
      "type": "text",
      "x": 4534.244337941135,
      "y": 4766.061436760204,
      "width": 644.599365234375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1k",
      "roundness": null,
      "seed": 1593761479,
      "version": 95,
      "versionNonce": 927419079,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785516888746,
      "link": null,
      "locked": false,
      "text": "If the renderer only draws points, this visibility test is sufficient.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If the renderer only draws points, this visibility test is sufficient.",
