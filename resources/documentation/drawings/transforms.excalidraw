      "updated": 1785516486872,
      "link": null,
      "locked": false,
      "text": "If vertexx A is ouside the clip volume but B and C are inside,\nthe GPU does not clamp A. Istead, it computes the intersection\nbetween the triangle's edged and the clipping planes, producing a\nnew polygon.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If vertexx A is ouside the clip volume but B and C are inside,\nthe GPU does not clamp A. Istead, it computes the intersection\nbetween the triangle's edged and the clipping planes, producing a\nnew polygon.",
      "autoResize": true,
      "lineHeight": 1.25
