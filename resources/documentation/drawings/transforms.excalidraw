      "updated": 1785515805696,
      "link": null,
      "locked": false,
      "text": "The perspective divide is NOT represented by a matrix multiplication\nbecuase it is a non-linear operations (division by the vaying value w).\n\nThe GPU performs it automatically after the vertex shader.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The perspective divide is NOT represented by a matrix multiplication\nbecuase it is a non-linear operations (division by the vaying value w).\n\nThe GPU performs it automatically after the vertex shader.",
      "autoResize": true,
      "lineHeight": 1.25
    },
