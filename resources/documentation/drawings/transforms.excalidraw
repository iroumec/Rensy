      "isDeleted": false,
      "boundElements": null,
      "updated": 1785514848584,
      "link": null,
      "locked": false,
      "text": "PERSPECTIVE PROJECTION\n\nProduces depth perception.\n\nParallel lines converge.\n\nObjects farther away appear smaller.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PERSPECTIVE PROJECTION\n\nProduces depth perception.\n\nParallel lines converge.\n\nObjects farther away appear smaller.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VHLzq_Z5SktLswkiK7m8o",
      "type": "text",
      "x": 1915.8586024532776,
      "y": 2648.700163974034,
      "width": 591.6194458007812,
      "height": 175,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b06",
      "roundness": null,
      "seed": 2120398151,
      "version": 141,
      "versionNonce": 851395527,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785514911958,
      "link": null,
      "locked": false,
      "text": "ORTGOGRAPHIC PROJECTION\n\nNo perspective.\n\nObjects keep the same apparent size regardless of distance.\n\nUsed in 2D games.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ORTGOGRAPHIC PROJECTION\n\nNo perspective.\n\nObjects keep the same apparent size regardless of distance.\n\nUsed in 2D games.",
      "autoResize": true,
      "lineHeight": 1.25
    },
