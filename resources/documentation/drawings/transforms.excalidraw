    {
      "id": "Ck8P9wDOoRm8k3viRejn2",
      "type": "text",
      "x": 2701.513293559935,
      "y": 3616.194309849794,
      "width": 610.0394287109375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b18",
      "roundness": null,
      "seed": 1546241063,
      "version": 70,
      "versionNonce": 2001317929,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785516015232,
      "link": null,
      "locked": false,
      "text": "In OpenGL, gl_posiiton always contains clip-space coordinates.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In OpenGL, gl_posiiton always contains clip-space coordinates.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "atiSHnaBn5jesxrn2dYGm",
      "type": "text",
      "x": 2875.274459492173,
      "y": 3696.6205019420754,
      "width": 681.9992065429688,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b19",
      "roundness": null,
      "seed": 962099689,
      "version": 88,
      "versionNonce": 2111390153,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785516037805,
      "link": null,
      "locked": false,
      "text": "gl_position = projection * view * model * vec4(position, 1.0);",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "gl_position = projection * view * model * vec4(position, 1.0);",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xw1izRg2hFjnhCs8Quf7i",
      "type": "text",
      "x": 1808.5916391852415,
      "y": 3583.9161471798916,
      "width": 484.0794982910156,
      "height": 50,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1A",
      "roundness": null,
      "seed": 528774535,
      "version": 147,
      "versionNonce": 842376617,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785516096558,
      "link": null,
      "locked": false,
      "text": "\"Should this primitive (or part of it) be discarded\nbecause it's outside the viewing volume?\"",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"Should this primitive (or part of it) be discarded\nbecause it's outside the viewing volume?\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "p9tlBaTZnV6tEOIJM9VFH",
      "type": "text",
      "x": 1656.5981418031063,
      "y": 3692.6907870056216,
      "width": 781.5767121639927,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1B",
      "roundness": null,
      "seed": 389884615,
      "version": 291,
      "versionNonce": 1497652295,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785516228040,
      "link": null,
      "locked": false,
      "text": "It's important to note than clipping iss not modifying a vertex so that it lies\ninside the viewing volume.\n\nInstead, clipping is the process of discarding or cutting primitives (triangles,\nlines, etc.) that extend outside the clip volume.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It's important to note than clipping iss not modifying a vertex so that it lies inside the viewing volume.\n\nInstead, clipping is the process of discarding or cutting primitives (triangles, lines, etc.) that extend outside the clip volume.",
      "autoResize": false,
      "lineHeight": 1.25
    },
