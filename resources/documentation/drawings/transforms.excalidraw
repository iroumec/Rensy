    },
    {
      "id": "Qtt5O2o7didnnL-Ezx6CN",
      "type": "text",
      "x": 3371.9164197359823,
      "y": 5212.23210232326,
      "width": 1428.435813228715,
      "height": 44.526230110283905,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1h",
      "roundness": null,
      "seed": 1817897129,
      "version": 172,
      "versionNonce": 254531911,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785516792576,
      "link": null,
      "locked": false,
      "text": "ONLY AFTER THIS PROCESS THE GPU PERFORM THE PERSPECTIVE DIVIDE",
      "fontSize": 35.62098408822711,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ONLY AFTER THIS PROCESS THE GPU PERFORM THE PERSPECTIVE DIVIDE",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Rt5Wgldr_w_uVaSWNhbQm",
      "type": "text",
      "x": 3417.598392770744,
      "y": 5285.523047199239,
      "width": 1030.279052734375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1i",
      "roundness": null,
      "seed": 847082375,
      "version": 163,
      "versionNonce": 470095273,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785516850562,
      "link": null,
      "locked": false,
      "text": "Dispate clipping being the most correct option, it's also valid, as an early implementation of a renderer, to\njust clamp the values.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dispate clipping being the most correct option, it's also valid, as an early implementation of a renderer, to\njust clamp the values.",
      "autoResize": true,
      "lineHeight": 1.25
    },
