    {
      "id": "LnsIm6m7CRS7Zh3NMH_04",
      "type": "text",
      "x": 4582.40675711178,
      "y": 4877.149314401944,
      "width": 947.6990966796875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1n",
      "roundness": null,
      "seed": 1400289609,
      "version": 146,
      "versionNonce": 965897447,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785516938153,
      "link": null,
      "locked": false,
      "text": "If it drawws LINES, a line clipping algorithm is needed (such as Cohen-Sutherland or Liang-Barky,\nadapted to homogeneus clip space).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If it drawws LINES, a line clipping algorithm is needed (such as Cohen-Sutherland or Liang-Barky,\nadapted to homogeneus clip space).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "iSEmK1YtUSJdBQzua92dd",
      "type": "text",
      "x": 4565.863938730295,
      "y": 5009.720038259088,
      "width": 968.3991088867188,
      "height": 50,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1o",
      "roundness": null,
      "seed": 835428135,
      "version": 155,
      "versionNonce": 131142025,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785516975407,
      "link": null,
      "locked": false,
      "text": "If it draws TRIANGLES, a polygon clipping is needed (Sutherland-Hodgman algorithm in homogeneus\nclip space, foe example).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If it draws TRIANGLES, a polygon clipping is needed (Sutherland-Hodgman algorithm in homogeneus\nclip space, foe example).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "R5lrtQODhMVelqQXGu6Wg",
      "type": "text",
      "x": 1724.9422079112037,
      "y": 4164.582099411869,
      "width": 746.559326171875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1q",
      "roundness": null,
      "seed": 418396297,
      "version": 12,
      "versionNonce": 1778289129,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785517091502,
      "link": null,
      "locked": false,
      "text": "In the perspective divide, every component is divided by w, including w itself.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In the perspective divide, every component is divided by w, including w itself.",
      "autoResize": true,
      "lineHeight": 1.25
    },
