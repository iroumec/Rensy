      "isDeleted": false,
      "boundElements": [],
      "updated": 1784989683700,
      "link": null,
      "locked": false,
      "text": "rightX = interpolateX(top, bottom, y);\n\nif (middle.y == top.y || middle.y == bottom.y) {\n    \n    leftX == (middle.y == top.y) ? interpolateX(middle, bottom, y) : interpolateX(top, middle, y);\n} else {\n    \n    leftX = (middle.y <= y) ? interpolateX(top, middle, y) : interpolateX(middle, bottom, y);\n\n    if (middle.x > top.x) std::swap(leftX, rightX);\n}",
      "fontSize": 22.49261721001727,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "rightX = interpolateX(top, bottom, y);\n\nif (middle.y == top.y || middle.y == bottom.y) {\n    \n    leftX == (middle.y == top.y) ? interpolateX(middle, bottom, y) : interpolateX(top, middle, y);\n} else {\n    \n    leftX = (middle.y <= y) ? interpolateX(top, middle, y) : interpolateX(middle, bottom, y);\n\n    if (middle.x > top.x) std::swap(leftX, rightX);\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
