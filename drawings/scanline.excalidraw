      "locked": false,
      "text": "rightX = interpolateX(top, bottom, y);\nleftX = (middle.y == top.y || middle.y > y) ? interpolateX(middle, bottom, y) : interpolateX(top, middle, y);\nif (middle.x > top.x) std::swap(leftX, rightX);",
      "fontSize": 22.49261721001727,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "rightX = interpolateX(top, bottom, y);\nleftX = (middle.y == top.y || middle.y > y) ? interpolateX(middle, bottom, y) : interpolateX(top, middle, y);\nif (middle.x > top.x) std::swap(leftX, rightX);",
      "autoResize": true,
      "lineHeight": 1.25
    },
